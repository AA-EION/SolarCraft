<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<Window x:Class="SolarCraft.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SolarCraft">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <CommandBar x:Name="Bar" DefaultLabelPosition="Right" HorizontalAlignment="Left">
      <AppBarButton x:Name="NewButton" Icon="Add" Click="OnNew" />
      <AppBarButton x:Name="OpenButton" Icon="OpenFile" Click="OnOpen" />
      <AppBarButton x:Name="UndoButton" Icon="Undo" Click="OnUndo" IsEnabled="False" />
      <AppBarSeparator />
      <AppBarButton x:Name="SimulateButton" Icon="Play" Click="OnSimulate" IsEnabled="False" />
      <AppBarButton x:Name="CancelButton" Icon="Cancel" Click="OnCancel" Visibility="Collapsed" />
    </CommandBar>
    <StackPanel Grid.Row="1">
      <ProgressBar x:Name="Progress" Maximum="1" Visibility="Collapsed" />
      <InfoBar x:Name="Info" IsOpen="False" />
    </StackPanel>
    <NavigationView x:Name="Nav" Grid.Row="2" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="OnNavigate" IsEnabled="False" Visibility="Collapsed">
      <NavigationView.Resources>
        <ResourceDictionary>
          <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Default">
              <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#244348" />
              <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#2F5157" />
              <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#233D42" />
              <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#F1FAF9" />
              <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#F1FAF9" />
              <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#F1FAF9" />
              <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#78D5CA" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Light">
              <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#DDEDEB" />
              <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#CEE6E3" />
              <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#BBDBD7" />
              <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#163439" />
              <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#163439" />
              <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#163439" />
              <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#286A65" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="HighContrast">
              <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
              <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
              <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemColorHighlightColor}" />
              <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{ThemeResource SystemColorHighlightTextColor}" />
              <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
              <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
              <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
            </ResourceDictionary>
          </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
      </NavigationView.Resources>
      <NavigationView.MenuItems>
        <NavigationViewItemHeader x:Name="NavSetup" />
        <NavigationViewItem x:Name="NavProject" Tag="project" Icon="Document" />
        <NavigationViewItem x:Name="NavSite" Tag="site" Icon="World" />
        <NavigationViewItem x:Name="NavLoads" Tag="loads" Icon="Calculator" />
        <NavigationViewItem x:Name="NavEv" Tag="ev" Icon="Calculator" />
        <NavigationViewItem x:Name="NavHeating" Tag="heating" Icon="Shop" />
        <NavigationViewItemHeader x:Name="NavSystem" />
        <NavigationViewItem x:Name="NavDesign" Tag="design" Icon="ViewAll" />
        <NavigationViewItem x:Name="NavRoof" Tag="roof" Icon="Home" />
        <NavigationViewItem x:Name="NavScene" Tag="scene" Icon="Globe" />
        <NavigationViewItem x:Name="NavElectrical" Tag="electrical" Icon="Switch" />
        <NavigationViewItem x:Name="NavStorage" Tag="storage" Icon="Shuffle" />
        <NavigationViewItem x:Name="NavCables" Tag="cables" Icon="Link" />
        <NavigationViewItem x:Name="NavPlans" Tag="plans" Icon="List" />
        <NavigationViewItemHeader x:Name="NavOutput" />
        <NavigationViewItem x:Name="NavEconomics" Tag="economics" Icon="Shop" />
        <NavigationViewItem x:Name="NavIsland" Tag="island" Icon="Shop" />
        <NavigationViewItem x:Name="NavResults" Tag="results" Icon="Play" />
        <NavigationViewItem x:Name="NavReport" Tag="report" Icon="Print" />
      </NavigationView.MenuItems>
      <NavigationView.Header>
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Spacing="4">
            <TextBlock x:Name="StepTitle" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock x:Name="StepStatus" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
            <Button x:Name="StepBack" Click="OnStepBack" />
            <Button x:Name="StepNext" Click="OnStepNext" />
          </StackPanel>
        </Grid>
      </NavigationView.Header>
      <ScrollViewer x:Name="PageScroll" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid x:Name="PageHost" Padding="24" MaxWidth="1100" HorizontalAlignment="Left">
          <StackPanel x:Name="ProjectPage" Spacing="10" Visibility="Collapsed">
            <TextBox x:Name="NameBox" Width="360" HorizontalAlignment="Left" LostFocus="OnTextCommit" Tag="/name" />
            <TextBox x:Name="CustomerBox" Width="360" HorizontalAlignment="Left" LostFocus="OnTextCommit" Tag="/customer/name" />
            <TextBox x:Name="AddressBox" Width="360" HorizontalAlignment="Left" LostFocus="OnTextCommit" Tag="/customer/address" />
          </StackPanel>

          <StackPanel x:Name="SitePage" Spacing="10" Visibility="Collapsed">
            <StackPanel x:Name="WorkflowPanel" Spacing="8" Margin="0,0,0,14" />
            <NumberBox x:Name="LatBox" Width="220" HorizontalAlignment="Left" Tag="/site/latitude" ValueChanged="OnNumber" />
            <NumberBox x:Name="LonBox" Width="220" HorizontalAlignment="Left" Tag="/site/longitude" ValueChanged="OnNumber" />
            <NumberBox x:Name="ElevBox" Width="220" HorizontalAlignment="Left" Tag="/site/elevation" ValueChanged="OnNumber" />
            <NumberBox x:Name="AlbedoBox" Width="220" HorizontalAlignment="Left" Tag="/site/albedo" ValueChanged="OnNumber" SmallChange="0.05" />
            <TextBlock x:Name="WeatherHeader" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <TextBlock x:Name="WeatherText" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="FetchButton" Click="OnFetch" />
              <Button x:Name="ImportButton" Click="OnImport" />
              <Button x:Name="DemoButton" Click="OnDemo" />
            </StackPanel>
            <TextBlock x:Name="DemoWarning" Opacity="0.7" TextWrapping="Wrap" />
            <StackPanel x:Name="GridPanel" Spacing="8" Margin="0,16,0,0" />
          </StackPanel>

          <StackPanel x:Name="ScenePage" Spacing="10" Visibility="Collapsed" />
          <StackPanel x:Name="ElectricalPage" Spacing="10" Visibility="Collapsed" />
          <StackPanel x:Name="LoadsPage" Spacing="10" Visibility="Collapsed" />
          <StackPanel x:Name="EvPage" Spacing="10" Visibility="Collapsed" />
          <StackPanel x:Name="HeatingPage" Spacing="10" Visibility="Collapsed" />
          <StackPanel x:Name="IslandPage" Spacing="10" Visibility="Collapsed" />
          <StackPanel x:Name="StoragePage" Spacing="10" Visibility="Collapsed" />
          <StackPanel x:Name="CablesPage" Spacing="10" Visibility="Collapsed" />
          <StackPanel x:Name="PlansPage" Spacing="10" Visibility="Collapsed" />
          <StackPanel x:Name="EconomicsPage" Spacing="10" Visibility="Collapsed" />

          <StackPanel x:Name="DesignPage" Spacing="10" Visibility="Collapsed">
            <ComboBox x:Name="DesignArrayBox" Width="300" SelectionChanged="OnDesignArray" />
            <ComboBox x:Name="ModuleBox" Width="340" SelectionChanged="OnDesignModule" />
            <ComboBox x:Name="InverterBox" Width="340" SelectionChanged="OnDesignInverter" />
            <RadioButtons x:Name="ModeRadios" SelectionChanged="OnMode" MaxColumns="2">
              <RadioButton x:Name="EasyRadio" />
              <RadioButton x:Name="DetailedRadio" />
            </RadioButtons>
            <TextBlock x:Name="ModeHint" Opacity="0.7" />
            <NumberBox x:Name="KwpBox" Width="220" HorizontalAlignment="Left" Tag="/arrays/0/target_kwp" ValueChanged="OnNumber" />
            <NumberBox x:Name="TiltBox" Width="220" HorizontalAlignment="Left" Tag="/arrays/0/tilt" ValueChanged="OnNumber" />
            <NumberBox x:Name="AzimuthBox" Width="220" HorizontalAlignment="Left" Tag="/arrays/0/azimuth" ValueChanged="OnNumber" />
            <StackPanel x:Name="TrackingPanel" Spacing="8" />
            <ComboBox x:Name="MountingBox" Width="220" SelectionChanged="OnMounting" />
            <ComboBox x:Name="PvModelBox" Width="220" SelectionChanged="OnPvModelChanged" />
            <NumberBox x:Name="MpsBox" Width="220" HorizontalAlignment="Left" Tag="/arrays/0/modules_per_string" ValueChanged="OnNumber" SpinButtonPlacementMode="Inline" Minimum="1" />
            <NumberBox x:Name="StringsBox" Width="220" HorizontalAlignment="Left" Tag="/arrays/0/strings" ValueChanged="OnNumber" SpinButtonPlacementMode="Inline" Minimum="1" />
            <TextBlock x:Name="EquipmentText" TextWrapping="Wrap" />
            <TextBlock x:Name="IssuesHeader" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <ItemsControl x:Name="IssuesList" />
          </StackPanel>

          <StackPanel x:Name="RoofPage" Spacing="10" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
              <ComboBox x:Name="PhotoArrayBox" Width="300" SelectionChanged="OnPhotoArray" />
              <Button x:Name="AddRoofArrayButton" Click="OnAddRoofArray" VerticalAlignment="Bottom" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="PhotoPlanButton" Click="OnPhotoPlan" />
              <Button x:Name="SavedPhotoButton" Click="OnSavedPhoto" Visibility="Collapsed" />
            </StackPanel>
            <ComboBox x:Name="RoofShapeBox" Width="260" SelectedIndex="0" SelectionChanged="OnRoofShape" />
            <NumberBox x:Name="EaveBox" Width="220" HorizontalAlignment="Left" Value="10" />
            <NumberBox x:Name="RidgeBox" Width="220" HorizontalAlignment="Left" Value="6" Visibility="Collapsed" />
            <NumberBox x:Name="SlopeBox" Width="220" HorizontalAlignment="Left" Value="5" />
            <TextBox x:Name="CustomBox" Width="520" HorizontalAlignment="Left" Visibility="Collapsed" TextChanged="OnCustomChanged" />
            <StackPanel x:Name="DraftPanel" Spacing="6" Visibility="Collapsed">
              <TextBlock x:Name="ClickHint" Opacity="0.7" />
              <Border BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Left">
                <Canvas x:Name="DraftCanvas" Width="700" Height="280" Background="Transparent" PointerPressed="OnDraftPressed" />
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="UndoPointButton" Click="OnUndoPoint" />
                <Button x:Name="ClearPointsButton" Click="OnClearPoints" />
              </StackPanel>
            </StackPanel>
            <TextBox x:Name="ObstaclesBox" Width="620" TextWrapping="Wrap" HorizontalAlignment="Left" />
            <TextBlock x:Name="RoofObstacleHint" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" />
            <NumberBox x:Name="SetbackBox" Width="220" HorizontalAlignment="Left" Value="0.4" SmallChange="0.05" />
            <NumberBox x:Name="ClearanceBox" Width="220" HorizontalAlignment="Left" Value="0.3" SmallChange="0.05" />
            <TextBlock x:Name="RoofHint" Opacity="0.7" TextWrapping="Wrap" />
            <Button x:Name="ApplyRoofButton" Style="{StaticResource AccentButtonStyle}" Click="OnApplyRoof" />
            <Canvas x:Name="RoofCanvas" Width="700" Height="320" HorizontalAlignment="Left" />
            <TextBlock x:Name="RoofCount" Style="{StaticResource SubtitleTextBlockStyle}" />
          </StackPanel>

          <StackPanel x:Name="ResultsPage" Spacing="14" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="RunResultsButton" Style="{StaticResource AccentButtonStyle}" Click="OnSimulate" />
              <Button x:Name="ResultsClimateButton" Click="OnResultsClimate" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock x:Name="NoResults" Opacity="0.7" TextWrapping="Wrap" />
            <StackPanel x:Name="PvsolComparisonPanel" Spacing="8" />
            <StackPanel x:Name="PlantResults" Spacing="12" />
            <StackPanel x:Name="Kpis" Orientation="Horizontal" Spacing="12" />
            <TextBlock x:Name="MonthlyHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel x:Name="MonthlyBars" Orientation="Horizontal" Spacing="6" Height="220" />
            <TextBlock x:Name="LossesHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid x:Name="LossGrid" ColumnSpacing="16" RowSpacing="4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            </Grid>
          </StackPanel>

          <StackPanel x:Name="ReportPage" Spacing="10" Visibility="Collapsed">
            <ComboBox x:Name="ReportTypeBox" Width="240" SelectedIndex="1" SelectionChanged="OnReportTypeChanged">
              <ComboBoxItem Tag="customer_short" />
              <ComboBoxItem Tag="customer_extended" />
              <ComboBoxItem Tag="system_planner" />
            </ComboBox>
            <ComboBox x:Name="LangBox" Width="220" SelectionChanged="OnReportLanguageChanged">
              <ComboBoxItem Content="English" Tag="en" />
              <ComboBoxItem Content="Español" Tag="es" />
              <ComboBoxItem Content="Deutsch" Tag="de" />
              <ComboBoxItem Content="Português (BR)" Tag="pt-BR" />
            </ComboBox>
            <ComboBox x:Name="FormatBox" Width="220" SelectedIndex="0">
              <ComboBoxItem Content="PDF" Tag="pdf" />
              <ComboBoxItem Content="DOCX" Tag="docx" />
            </ComboBox>
            <TextBox x:Name="DesignerBox" Width="360" HorizontalAlignment="Left" />
            <Button x:Name="ExportButton" Style="{StaticResource AccentButtonStyle}" Click="OnExport" />
            <StackPanel x:Name="PreviewPanel" Spacing="8" Margin="0,16,0,0" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </NavigationView>
    <StackPanel x:Name="WelcomePage" Grid.Row="2" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock x:Name="WelcomeTitle" Style="{StaticResource TitleTextBlockStyle}" TextAlignment="Center" />
      <TextBlock x:Name="EmptyText" TextWrapping="Wrap" TextAlignment="Center" />
      <StackPanel Spacing="8" Orientation="Horizontal" HorizontalAlignment="Center">
        <Button x:Name="WelcomeNew" Click="OnNew" Style="{StaticResource AccentButtonStyle}" />
        <Button x:Name="WelcomeOpen" Click="OnOpen" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
