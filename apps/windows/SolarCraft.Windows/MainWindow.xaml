<Window x:Class="SolarCraft.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SolarCraft">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <CommandBar x:Name="Bar" DefaultLabelPosition="Right" HorizontalAlignment="Left">
      <AppBarButton x:Name="NewButton" Icon="Add" Click="OnNew" />
      <AppBarButton x:Name="OpenButton" Icon="OpenFile" Click="OnOpen" />
      <AppBarButton x:Name="UndoButton" Icon="Undo" Click="OnUndo" IsEnabled="False" />
      <AppBarSeparator />
      <AppBarButton x:Name="SimulateButton" Icon="Play" Click="OnSimulate" IsEnabled="False" />
      <AppBarButton x:Name="CancelButton" Icon="Cancel" Click="OnCancel" Visibility="Collapsed" />
    </CommandBar>
    <StackPanel Grid.Row="1">
      <ProgressBar x:Name="Progress" Maximum="1" Visibility="Collapsed" />
      <InfoBar x:Name="Info" IsOpen="False" />
    </StackPanel>
    <NavigationView x:Name="Nav" Grid.Row="2" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="OnNavigate" IsEnabled="False">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="NavProject" Tag="project" Icon="Document" />
        <NavigationViewItem x:Name="NavSite" Tag="site" Icon="World" />
        <NavigationViewItem x:Name="NavDesign" Tag="design" Icon="ViewAll" />
        <NavigationViewItem x:Name="NavRoof" Tag="roof" Icon="Home" />
        <NavigationViewItem x:Name="NavResults" Tag="results" Icon="Calculator" />
        <NavigationViewItem x:Name="NavReport" Tag="report" Icon="Print" />
      </NavigationView.MenuItems>
      <ScrollViewer>
        <Grid Padding="24" MaxWidth="820" HorizontalAlignment="Left">
          <TextBlock x:Name="EmptyText" Style="{StaticResource SubtitleTextBlockStyle}" />

          <StackPanel x:Name="ProjectPage" Spacing="10" Visibility="Collapsed">
            <TextBox x:Name="NameBox" Width="360" HorizontalAlignment="Left" LostFocus="OnTextCommit" Tag="/name" />
            <TextBox x:Name="CustomerBox" Width="360" HorizontalAlignment="Left" LostFocus="OnTextCommit" Tag="/customer/name" />
            <TextBox x:Name="AddressBox" Width="360" HorizontalAlignment="Left" LostFocus="OnTextCommit" Tag="/customer/address" />
          </StackPanel>

          <StackPanel x:Name="SitePage" Spacing="10" Visibility="Collapsed">
            <NumberBox x:Name="LatBox" Width="220" HorizontalAlignment="Left" Tag="/site/latitude" ValueChanged="OnNumber" />
            <NumberBox x:Name="LonBox" Width="220" HorizontalAlignment="Left" Tag="/site/longitude" ValueChanged="OnNumber" />
            <NumberBox x:Name="ElevBox" Width="220" HorizontalAlignment="Left" Tag="/site/elevation" ValueChanged="OnNumber" />
            <NumberBox x:Name="AlbedoBox" Width="220" HorizontalAlignment="Left" Tag="/site/albedo" ValueChanged="OnNumber" SmallChange="0.05" />
            <TextBlock x:Name="WeatherHeader" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <TextBlock x:Name="WeatherText" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="FetchButton" Click="OnFetch" />
              <Button x:Name="ImportButton" Click="OnImport" />
              <Button x:Name="DemoButton" Click="OnDemo" />
            </StackPanel>
            <TextBlock x:Name="DemoWarning" Opacity="0.7" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel x:Name="DesignPage" Spacing="10" Visibility="Collapsed">
            <RadioButtons x:Name="ModeRadios" SelectionChanged="OnMode" MaxColumns="2">
              <RadioButton x:Name="EasyRadio" />
              <RadioButton x:Name="DetailedRadio" />
            </RadioButtons>
            <TextBlock x:Name="ModeHint" Opacity="0.7" />
            <NumberBox x:Name="KwpBox" Width="220" HorizontalAlignment="Left" Tag="/arrays/0/target_kwp" ValueChanged="OnNumber" />
            <NumberBox x:Name="TiltBox" Width="220" HorizontalAlignment="Left" Tag="/arrays/0/tilt" ValueChanged="OnNumber" />
            <NumberBox x:Name="AzimuthBox" Width="220" HorizontalAlignment="Left" Tag="/arrays/0/azimuth" ValueChanged="OnNumber" />
            <ComboBox x:Name="MountingBox" Width="220" SelectionChanged="OnMounting" />
            <NumberBox x:Name="MpsBox" Width="220" HorizontalAlignment="Left" Tag="/arrays/0/modules_per_string" ValueChanged="OnNumber" SpinButtonPlacementMode="Inline" Minimum="1" />
            <NumberBox x:Name="StringsBox" Width="220" HorizontalAlignment="Left" Tag="/arrays/0/strings" ValueChanged="OnNumber" SpinButtonPlacementMode="Inline" Minimum="1" />
            <TextBlock x:Name="EquipmentText" TextWrapping="Wrap" />
            <TextBlock x:Name="IssuesHeader" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <ItemsControl x:Name="IssuesList" />
          </StackPanel>

          <StackPanel x:Name="RoofPage" Spacing="10" Visibility="Collapsed">
            <ComboBox x:Name="RoofShapeBox" Width="260" SelectedIndex="0" SelectionChanged="OnRoofShape" />
            <NumberBox x:Name="EaveBox" Width="220" HorizontalAlignment="Left" Value="10" />
            <NumberBox x:Name="RidgeBox" Width="220" HorizontalAlignment="Left" Value="6" Visibility="Collapsed" />
            <NumberBox x:Name="SlopeBox" Width="220" HorizontalAlignment="Left" Value="5" />
            <TextBox x:Name="CustomBox" Width="520" HorizontalAlignment="Left" Visibility="Collapsed" />
            <TextBox x:Name="ObstaclesBox" Width="520" HorizontalAlignment="Left" />
            <NumberBox x:Name="SetbackBox" Width="220" HorizontalAlignment="Left" Value="0.4" SmallChange="0.05" />
            <NumberBox x:Name="ClearanceBox" Width="220" HorizontalAlignment="Left" Value="0.3" SmallChange="0.05" />
            <TextBlock x:Name="RoofHint" Opacity="0.7" TextWrapping="Wrap" />
            <Button x:Name="ApplyRoofButton" Style="{StaticResource AccentButtonStyle}" Click="OnApplyRoof" />
            <Canvas x:Name="RoofCanvas" Width="700" Height="320" HorizontalAlignment="Left" />
            <TextBlock x:Name="RoofCount" Style="{StaticResource SubtitleTextBlockStyle}" />
          </StackPanel>

          <StackPanel x:Name="ResultsPage" Spacing="14" Visibility="Collapsed">
            <TextBlock x:Name="NoResults" Opacity="0.7" />
            <StackPanel x:Name="Kpis" Orientation="Horizontal" Spacing="12" />
            <TextBlock x:Name="MonthlyHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel x:Name="MonthlyBars" Orientation="Horizontal" Spacing="6" Height="220" />
            <TextBlock x:Name="LossesHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid x:Name="LossGrid" ColumnSpacing="16" RowSpacing="4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            </Grid>
          </StackPanel>

          <StackPanel x:Name="ReportPage" Spacing="10" Visibility="Collapsed">
            <ComboBox x:Name="LangBox" Width="220">
              <ComboBoxItem Content="English" Tag="en" />
              <ComboBoxItem Content="Español" Tag="es" />
              <ComboBoxItem Content="Deutsch" Tag="de" />
              <ComboBoxItem Content="Português (BR)" Tag="pt-BR" />
            </ComboBox>
            <ComboBox x:Name="FormatBox" Width="220" SelectedIndex="0">
              <ComboBoxItem Content="PDF" Tag="pdf" />
              <ComboBoxItem Content="DOCX" Tag="docx" />
            </ComboBox>
            <TextBox x:Name="DesignerBox" Width="360" HorizontalAlignment="Left" />
            <Button x:Name="ExportButton" Style="{StaticResource AccentButtonStyle}" Click="OnExport" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </NavigationView>
  </Grid>
</Window>
